# ─────────────────────────────────────────────────────────────
# Set these in: Vercel Dashboard → Project → Settings → Environment Variables
# For local dev with Vercel CLI: copy this file to .env.local and fill in values,
# then run `vercel dev` to test the function at http://localhost:3000
# ─────────────────────────────────────────────────────────────

# Resend API key — resend.com → API Keys
RESEND_API_KEY=API_KEY

# Zelle handle — the email address or phone number your Zelle account is registered to
ZELLE_HANDLE=booking@summazescape.com

# Venmo handle — your @username on Venmo
VENMO_HANDLE=@SummazEscape

# Google Apps Script URL — keeps your Google Sheets admin log updated
# This is your existing webapp.gs deployment URL
GAS_URL=https://script.google.com/macros/s/AKfycbyiXumXEUbE3d2brw3rmcEM2A0Ka3du6gGnkF37rxunSVqwhoqLpCUnlO55IBiIOuyqhA/exec
